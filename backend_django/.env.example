# Django Configuration
DEBUG=False
SECRET_KEY=replace-with-a-secure-secret-key-in-production
ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Option A: Full connection URL (Render / Railway / Heroku / Supabase / Neon)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: Individual database parameters (Local or custom PostgreSQL)
DB_NAME=veloop_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
